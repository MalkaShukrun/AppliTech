---
const field =
  'mt-2 w-full rounded-xl border border-white/10 bg-ink px-4 py-3 text-white placeholder-gray-500 outline-none transition focus:border-brand-400 focus:ring-2 focus:ring-brand-500/30';
---

<section id="contact" class="py-20 sm:py-28">
  <div class="mx-auto max-w-2xl px-5">
    <div class="text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">יצירת קשר</h2>
      <p class="mt-4 text-gray-400">ספרו לנו על הפרויקט ונחזור אליכם בהקדם.</p>
    </div>

    <form id="contact-form" class="mt-10 space-y-5 rounded-2xl border border-white/10 bg-ink-soft p-6 sm:p-8" novalidate>
      <div>
        <label for="name" class="text-sm font-medium text-gray-200">שם מלא</label>
        <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" class={field} />
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="email" class="text-sm font-medium text-gray-200">דוא"ל</label>
          <input id="email" name="email" type="email" required maxlength="150" autocomplete="email" dir="ltr" class={field + ' text-right'} />
        </div>
        <div>
          <label for="phone" class="text-sm font-medium text-gray-200">טלפון</label>
          <input id="phone" name="phone" type="tel" required maxlength="30" autocomplete="tel" dir="ltr" class={field + ' text-right'} />
        </div>
      </div>
      <div>
        <label for="message" class="text-sm font-medium text-gray-200">תיאור הפרויקט</label>
        <textarea id="message" name="message" rows="5" required maxlength="3000" class={field}></textarea>
      </div>

      <!-- Honeypot: hidden from real users, bots tend to fill it -->
      <div class="absolute -left-[9999px]" aria-hidden="true">
        <label>אל תמלאו שדה זה<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
      </div>

      <button
        id="submit-btn"
        type="submit"
        class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3.5 font-bold text-white transition hover:bg-brand-500 disabled:cursor-not-allowed disabled:opacity-60"
      >
        <svg id="spinner" class="hidden h-5 w-5 animate-spin" viewBox="0 0 24 24" fill="none">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" class="opacity-25"></circle>
          <path d="M4 12a8 8 0 018-8" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
        </svg>
        <span id="btn-label">שליחה</span>
      </button>

      <p id="form-status" role="status" aria-live="polite" class="hidden rounded-xl px-4 py-3 text-sm"></p>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const btn = document.getElementById('submit-btn') as HTMLButtonElement | null;
  const label = document.getElementById('btn-label');
  const spinner = document.getElementById('spinner');
  const status = document.getElementById('form-status');

  function show(kind: 'success' | 'error', text: string) {
    if (!status) return;
    status.textContent = text;
    status.className =
      'rounded-xl px-4 py-3 text-sm ' +
      (kind === 'success'
        ? 'bg-emerald-500/15 text-emerald-300 border border-emerald-500/30'
        : 'bg-red-500/15 text-red-300 border border-red-500/30');
  }

  function setLoading(loading: boolean) {
    if (!btn || !label || !spinner) return;
    btn.disabled = loading;
    spinner.classList.toggle('hidden', !loading);
    label.textContent = loading ? 'שולח...' : 'שליחה';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form.reportValidity()) return;

    setLoading(true);
    status?.classList.add('hidden');

    try {
      const res = await fetch('/api/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(Object.fromEntries(new FormData(form))),
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        show('success', 'תודה! ההודעה נשלחה בהצלחה, ניצור איתך קשר בהקדם.');
        form.reset();
      } else {
        show('error', data.error || 'אירעה שגיאה בשליחת ההודעה. נסו שוב מאוחר יותר.');
      }
    } catch {
      show('error', 'לא ניתן להתחבר לשרת. בדקו את החיבור ונסו שוב.');
    } finally {
      setLoading(false);
    }
  });
</script>
