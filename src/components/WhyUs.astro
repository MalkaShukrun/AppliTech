---
const reasons = [
  { title: 'קוד איכותי', text: 'קוד נקי, מתועד ונבדק, שקל לתחזק ולהרחיב לאורך זמן.' },
  { title: 'אינטגרציות AI מתקדמות', text: 'שילוב הטכנולוגיות והמודלים החדשים ביותר בתוך המערכת שלכם.' },
  { title: 'אחריות מקצה לקצה', text: 'נקודת קשר אחת מהאפיון ועד ההפעלה והתמיכה השוטפת.' },
  { title: 'ביצועים מהירים', text: 'מערכות מהירות ויעילות שמספקות חוויית משתמש חלקה.' },
  { title: 'התאמה אישית מלאה', text: 'כל פתרון נבנה סביב התהליכים והמטרות הייחודיים שלכם.' },
];
---

<section id="about" class="border-y border-white/10 bg-ink-soft py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold text-white sm:text-4xl">למה AppliTech?</h2>
      <p class="mt-4 text-gray-400">
        אנחנו חברת טכנולוגיה שמשלבת הנדסת תוכנה עמוקה עם ידע מעשי בבינה מלאכותית.
      </p>
    </div>

    <ul class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {reasons.map((r) => (
        <li class="flex gap-4 rounded-2xl border border-white/10 bg-ink p-6">
          <span class="mt-1 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-500/20 text-brand-400">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
          </span>
          <div>
            <h3 class="font-bold text-white">{r.title}</h3>
            <p class="mt-1 text-sm leading-relaxed text-gray-400">{r.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
